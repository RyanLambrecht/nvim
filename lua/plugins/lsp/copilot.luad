---@type LazySpec
return {
  --------------------
  --main plugin
  --------------------
  {
    'zbirenbaum/copilot.lua',
    cmd = 'Copilot',
    --event = 'VeryLazy', -- doesn't touch your startup time
    -- event = 'InsertEnter', -- doesn't touch your startup time
    keys = {
      { '<leader>c' }, -- just to delay it loading
    },

    opts = {
      suggestion = { enabled = false }, -- blink handles display
      panel = { enabled = false },
    },
  },
  --------------------
  --blink
  --------------------
  {
    'fang2hou/blink-copilot',
    dependencies = { 'zbirenbaum/copilot.lua' },
    keys = {
      { '<leader>c' }, -- just to delay it loading
    },
  },
  --------------------
  --chat
  --------------------
  {
    'CopilotC-Nvim/CopilotChat.nvim',
    dependencies = {
      'zbirenbaum/copilot.lua',
      'nvim-lua/plenary.nvim',
    },
    build = 'make tiktoken', -- optional, better token counting
    cmd = 'CopilotChat',
    keys = {
      { '<leader>cc', '<cmd>CopilotChatToggle<cr>', mode = { 'n', 'v' }, desc = 'Copilot Chat' },
      { '<leader>ce', '<cmd>CopilotChatExplain<cr>', mode = 'v', desc = 'Explain selection' },
      { '<leader>cr', '<cmd>CopilotChatReset<cr>', desc = 'Reset chat' },
      { '<leader>cm', '<cmd>CopilotChatModels<cr>', desc = 'Pick model' },
      { '<leader>cp', '<cmd>CopilotChatPrompts<cr>', mode = { 'n', 'v' }, desc = 'Prompts' },
      { '<leader>ct', '<cmd>CopilotChatTests<cr>', mode = 'v', desc = 'Generate tests' },
      { '<leader>cf', '<cmd>CopilotChatFix<cr>', mode = 'v', desc = 'Fix selection' },
      {
        '<leader>cq', -- quick question, cheap model
        function()
          local input = vim.fn.input 'Quick: '
          if input ~= '' then
            require('CopilotChat').ask(input, { selection = require('#buffer').buffer })
          end
        end,
        desc = 'Copilot quick (cheap)',
      },
    },
    opts = {
      window = {
        --  layout = 'float',
        width = 80, -- Fixed width in columns
        -- height = 20, -- Fixed height in rows
        -- border = 'rounded', -- 'single', 'double', 'rounded', 'solid'
        -- title = '🤖 AI Assistant',
        -- zindex = 100, -- Ensure window stays on top
      },
    },
  },
}
